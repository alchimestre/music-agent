# Copy to `.env` and fill in. `.env` is gitignored.
#
#     set -a; source .env; set +a

MUSICBRAINZ_CONTACT=            # email or URL, sent as the MusicBrainz User-Agent
ACOUSTID_API_KEY=               # https://acoustid.org/applications
DISCOGS_TOKEN=                  # personal access token
SLSK_USERNAME=
SLSK_PASSWORD=

# The ports aioslsk binds. Forward the first on the router: a peer that cannot reach it cannot deliver search
# results, and every search comes back empty. The obfuscated listener takes the port after it.
SLSK_LISTEN_PORT=20000
SLSK_OBFUSCATED_PORT=20001
