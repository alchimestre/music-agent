# Copy to `.env` and fill in. `.env` is gitignored.
#
#     set -a; source .env; set +a

MUSICBRAINZ_CONTACT=            # email or URL, sent as the MusicBrainz User-Agent
ACOUSTID_API_KEY=               # https://acoustid.org/applications
DISCOGS_TOKEN=                  # personal access token
SLSK_USERNAME=
SLSK_PASSWORD=

# The one port the daemon registers. Forward it on the router: a peer that cannot reach it cannot open the
# connection that carries the file, and a search answer without one is an offer nobody can take.
SLSK_LISTEN_PORT=20000
